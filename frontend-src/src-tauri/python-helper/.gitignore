# Entorno virtual y artefactos de PyInstaller -- se regeneran con
# `python -m venv .venv && .venv/Scripts/pip install -r requirements.txt`
# y `.venv/Scripts/pyinstaller --onedir --name python-helper --distpath dist --workpath build src/main.py`.
# dist/ es lo que tauri.conf.json referencia como recurso -- hace falta
# compilarlo antes de `npm run tauri:build`, no se versiona (pesa decenas
# de MB y es 100% reproducible desde requirements.txt).
.venv/
build/
dist/
__pycache__/
*.pyc
# python-helper.spec SÍ se versiona (quitado de aquí a propósito): hace
# falta a mano para anonimizar-* (collect_data_files de es_core_news_md +
# los dos JSON del anonimizador como datos, ver el propio .spec) -- sin él,
# "pyinstaller src/main.py" a pelo regenera un .spec por defecto sin eso y
# el modelo no carga ya congelado, aunque compile sin errores (confirmado
# en real).
